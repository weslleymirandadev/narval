# Narval standard library -- string helpers.
#
# Bring them into a program with:
#     from "stdlib/strings.nv" import *;
#
# These are ordinary runtime functions written in Narval: while loops, indexing
# (s[i] yields a one-character string), len() and vector push. Unbounded helpers
# return -1 / "" instead of raising, since the language has no exceptions.
# Statements in a `def` body are terminated with `;`.

# A whitespace character. The trim helpers used to compare against " " only, so
# a tab or a newline counted as text and `trim_left("\thi")` came back unchanged.
def nv_is_space(c: str): bool {
    return c == " " || c == "\t" || c == "\n" || c == "\r";
}

# Index of the first character, skipping leading spaces.
def nv_first_nonspace(s: str): int {
    i = 0;
    found = false;
    while found == false {
        if i >= len(s) {
            found = true;
        } else {
            if nv_is_space(s[i]) {
                i = i + 1;
            } else {
                found = true;
            }
        }
    }
    return i;
}

# Index one past the last non-space character.
def nv_last_nonspace(s: str): int {
    stop = len(s);
    trimming = true;
    while trimming {
        if stop <= 0 {
            trimming = false;
        } else {
            if nv_is_space(s[stop - 1]) {
                stop = stop - 1;
            } else {
                trimming = false;
            }
        }
    }
    return stop;
}

def trim_left(s: str): str {
    out = "";
    i = nv_first_nonspace(s);
    while i < len(s) {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

def trim_right(s: str): str {
    out = "";
    stop = nv_last_nonspace(s);
    i = 0;
    while i < stop {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

def trim(s: str): str {
    return trim_left(trim_right(s));
}

def starts_with(s: str, prefix: str): bool {
    if len(prefix) > len(s) {
        return false;
    }
    i = 0;
    ok = true;
    while i < len(prefix) {
        if s[i] != prefix[i] {
            ok = false;
            i = len(prefix);
        } else {
            i = i + 1;
        }
    }
    return ok;
}

def ends_with(s: str, suffix: str): bool {
    if len(suffix) > len(s) {
        return false;
    }
    offset = len(s) - len(suffix);
    i = 0;
    ok = true;
    while i < len(suffix) {
        if s[offset + i] != suffix[i] {
            ok = false;
            i = len(suffix);
        } else {
            i = i + 1;
        }
    }
    return ok;
}

# -1 when `sub` does not occur. Single loop, single condition per step: a loop
# nested inside a conditional is the one shape the conditional lowering cannot
# carry values out of.
def index_of(s: str, sub: str): int {
    if len(sub) == 0 {
        return 0;
    }
    if len(sub) > len(s) {
        return -1;
    }
    found = -1;
    i = 0;
    done = false;
    while done == false {
        if i + len(sub) > len(s) {
            done = true;
        } else {
            if starts_at(s, i, sub) {
                found = i;
                done = true;
            } else {
                i = i + 1;
            }
        }
    }
    return found;
}

def contains(s: str, sub: str): bool {
    return index_of(s, sub) >= 0;
}

# `count` characters starting at `start`; clamps to the string bounds.
def substr(s: str, start: int, count: int): str {
    out = "";
    if start < 0 {
        return out;
    }
    i = start;
    stop = start + count;
    if stop > len(s) {
        stop = len(s);
    }
    while i < stop {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

# True when `sub` occurs at `start`.
def starts_at(s: str, start: int, sub: str): bool {
    if start < 0 {
        return false;
    }
    if start + len(sub) > len(s) {
        return false;
    }
    i = 0;
    ok = true;
    while i < len(sub) {
        if s[start + i] != sub[i] {
            ok = false;
            i = len(sub);
        } else {
            i = i + 1;
        }
    }
    return ok;
}

# Splits on every occurrence of `sep`; an empty separator returns the whole
# string as a single part.
def split(s: str, sep: str): vector {
    parts = [];
    if len(sep) == 0 {
        parts.push(s);
        return parts;
    }
    current = "";
    i = 0;
    while i < len(s) {
        if starts_at(s, i, sep) {
            parts.push(current);
            current = "";
            i = i + len(sep);
        } else {
            current = current + s[i];
            i = i + 1;
        }
    }
    parts.push(current);
    return parts;
}

def join(parts: vector, sep: str): str {
    out = "";
    i = 0;
    while i < len(parts) {
        if i > 0 {
            out = out + sep;
        }
        out = out + parts[i];
        i = i + 1;
    }
    return out;
}

# Replaces every occurrence of `needle` (empty `needle` is ignored).
def replace(s: str, needle: str, to: str): str {
    if len(needle) == 0 {
        return s;
    }
    out = "";
    i = 0;
    while i < len(s) {
        if starts_at(s, i, needle) {
            out = out + to;
            i = i + len(needle);
        } else {
            out = out + s[i];
            i = i + 1;
        }
    }
    return out;
}

# Number of occurrences of `sub`.
def count_of(s: str, sub: str): int {
    if len(sub) == 0 {
        return 0;
    }
    n = 0;
    i = 0;
    while i + len(sub) <= len(s) {
        if starts_at(s, i, sub) {
            n = n + 1;
            i = i + len(sub);
        } else {
            i = i + 1;
        }
    }
    return n;
}

# ---- Number <-> text conversions. These belong to the prelude, not to a module face: a
# program that wants to parse "42" should not have to import the whole net module (that is
# where the only decimal parser used to live, as net_digits_to_int, which now delegates
# here). The house convention applies: an unbounded helper returns -1 / "" instead of
# raising, since the language has no exceptions.

# Value of one hex digit, case-insensitive, or -1.
def hex_digit_value(c: str): int {
    mut d = index_of("0123456789", c);
    if d >= 0 { return d; }
    mut lo = index_of("abcdef", c);
    if lo >= 0 { return 10 + lo; }
    mut hi = index_of("ABCDEF", c);
    if hi >= 0 { return 10 + hi; }
    return -1;
}

# A whole decimal string -> integer. -1 when it is not one (empty, signed, any non-digit).
def to_int(t: str): int {
    if len(t) == 0 { return -1; }
    mut v = 0;
    mut i = 0;
    while i < len(t) {
        mut d = index_of("0123456789", substr(t, i, 1));
        if d < 0 { return -1; }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

# A whole hex string -> integer (case-insensitive). -1 when it is not hex.
def hex_to_int(t: str): int {
    if len(t) == 0 { return -1; }
    mut v = 0;
    mut i = 0;
    while i < len(t) {
        mut d = hex_digit_value(substr(t, i, 1));
        if d < 0 { return -1; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

# (No int_to_str here: the `str` builtin already renders an integer, sign included. A second
# way to do it would be two words for one capacity.)

# Integer -> hex text, zero-padded to `digits` (min 1), masked to that width. Note `//`: `/`
# is exact-or-float here (1 / 10 is 0.1), so a base-10 loop with `/` never reaches zero — that
# is exactly how the first version of this file looped forever appending zeros.
def int_to_hex(v: int, digits: int): str {
    mut w = digits;
    if w < 1 { w = 1; }
    mut s = "";
    mut n = v;
    mut k = 0;
    while k < w {
        s = substr("0123456789abcdef", n % 16, 1) + s;
        n = n // 16;
        k = k + 1;
    }
    return s;
}
