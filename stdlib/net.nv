# Network for Narval: addresses, TCP, UDP, DNS, timeouts and the knobs an advanced user wants.
#
#     from "net" import *;
#
#     # a server
#     srv = new TcpListener();
#     srv.bind("127.0.0.1", 8080);
#     conn = srv.accept(5000);            # -2 when nothing arrived in 5s
#     if conn >= 0 {
#         c = TcpStream.wrap(conn);
#         write(c.recv_line());
#         c.send_line("ok");
#         c.close();
#     }
#     srv.close();
#
#     # a client
#     t = new TcpStream();
#     if t.connect("127.0.0.1", 8080, 5000) == 0 { t.send_line("oi"); write(t.recv_line()); }
#
#     # UDP (no second process needed: send to yourself)
#     u = new UdpSocket();
#     u.bind("127.0.0.1", 0);             # 0 = any free port
#     u.send_to("127.0.0.1", u.port(), "ping");
#     d = new Datagram(); d.parse(u.recv_from(2000));   # data == "" on timeout
#
#     # names
#     write(Dns.resolve("localhost"));    # "127.0.0.1"
#     a = new Address();
#     a.parse("example.com:443");         # host "example.com", port 443
#
# Everything below is a thin class over the runtime's socket primitives
# (src/backend/runtime/net/net_socket.c, net_addr.c): a socket is a small integer handle, the
# same model as File. Empty results are never silent — `status()` after a read says what
# happened (0 ok, 1 timed out, 2 peer closed, -1 error) and `net_last_error()` carries the
# platform message. Timeouts are milliseconds on every platform.
#
# The advanced entry points are the ones that take raw knobs: `TcpListener.accept(ms)`,
# `TcpStream.option(name, value)`, `TcpStream.nonblocking()`, `net_poll(handles, mode, ms)`,
# the address helpers (`net_host_of`, `net_port_of`) and the parse/format pair. A protocol
# written on top of this (framing, handshakes, custom transports) uses those, not the
# convenience methods.

# ── status codes ──────────────────────────────────────────────────────────────
def net_ok(): int { return 0; }
def net_timed_out(): int { return 1; }
def net_closed(): int { return 2; }
def net_failed(): int { return -1; }
# accept() returns this when the timeout expired (a socket handle is never negative otherwise).
def net_no_connection(): int { return -2; }

# ── module-level helpers (the advanced API) ────────────────────────────────────
def net_last_error(): str { return nv_net_last_error(); }
def net_last_len(): int { return nv_net_last_len(); }
def net_hostname(): str { return nv_net_hostname(); }
def net_status(handle: int): int { return nv_net_status(handle); }

# "host:port" normalised (IPv6 in brackets); "" when the text is not an endpoint.
def net_addr(text: str): str { return nv_net_addr_parse(text); }

# Host of "host:port" (brackets of an IPv6 literal are stripped). Splitting in C keeps it
# exact for every shape ("[::1]:80", bare IPv6, ":8080").
def net_host_of(addr: str): str { return nv_net_host_of(addr); }

# Port of "host:port"; 0 when there is none.
def net_port_of(addr: str): int { return nv_net_port_of(addr); }

# Name resolution without an object, for the common case.
def net_resolve(host: str): str { return nv_net_resolve(host); }
def net_resolve_all(host: str): str { return nv_net_resolve_all(host); }

# Handles ready for reading/writing. handles is a CSV ("3,7"), mode "r"/"w"/"rw".
def net_poll(handles: str, mode: str, timeout_ms: int): str {
    return nv_net_poll(handles, mode, timeout_ms);
}

# ── addresses and names ───────────────────────────────────────────────────────
class Address {
    # Public: an address is plain data, the caller reads it.
    public host: str;
    public port: int;
    public canonical: str;      # what parse() normalised, kept as-is

    # Fills host/port from "host:port" (or from a bare host, port 0). 0 on success.
    public parse(text: str): int {
        normalised = nv_net_addr_parse(text);
        if len(normalised) == 0 { self.host = ""; self.port = 0; self.canonical = ""; return -1; }
        self.canonical = normalised;
        self.host = net_host_of(normalised);
        self.port = net_port_of(normalised);
        if self.host == "" && self.port == 0 { return -1; }
        return 0;
    }

    public load(host: str, port: int): int {
        self.host = host;
        self.port = port;
        self.canonical = "";
        return 0;
    }

    # Canonical text: "1.2.3.4:80" or "[::1]:80".
    public text(): str {
        if len(self.canonical) > 0 { return self.canonical; }
        if len(self.host) == 0 { return ":" + str(self.port); }
        # index_of answers -1 when there is no colon, so a plain IPv4 host stays bare.
        if index_of(self.host, ":") >= 0 { return "[" + self.host + "]:" + str(self.port); }
        return self.host + ":" + str(self.port);
    }
}

# Name resolution as an object, for symmetry with the rest. The module functions above
# (net_resolve/net_resolve_all/net_hostname) are the same calls without the instance — the
# language has no static methods, so `Dns.resolve(...)` on the class name is not a thing.
# resolve() gives the first answer, resolve_all() every answer (';'-separated, resolver
# order): pick one, try the next, that is the caller's policy.
class Dns {
    public resolve(host: str): str { return nv_net_resolve(host); }
    public resolve_all(host: str): str { return nv_net_resolve_all(host); }
    public hostname(): str { return nv_net_hostname(); }
}

# ── TCP ───────────────────────────────────────────────────────────────────────
class TcpListener {
    public handle: int;

    # Binds and listens. host "" (or "0.0.0.0") = every interface; 0 = any free port.
    public bind(host: str, port: int): int {
        self.handle = nv_net_tcp_listen(host, port);
        if self.handle < 0 { return -1; }
        return 0;
    }

    # Waits for one connection: a stream handle, or net_no_connection() on timeout
    # (timeout_ms 0 = wait forever).
    public accept(timeout_ms: int): int {
        return nv_net_accept(self.handle, timeout_ms);
    }

    public port(): int { return nv_net_local_port(self.handle); }
    public addr(): str { return nv_net_local_addr(self.handle); }
    public close(): int { return nv_net_close(self.handle); }
}

class TcpStream {
    public handle: int;

    # Connects; 0 on success, -1 on failure (net_last_error() tells why). timeout_ms 0 waits
    # forever, otherwise the connect is abandoned at the deadline.
    public connect(host: str, port: int, timeout_ms: int): int {
        self.handle = nv_net_tcp_connect(host, port, timeout_ms);
        if self.handle < 0 { return -1; }
        return 0;
    }

    # Takes over a handle that already exists (one from accept(), or another object's).
    public adopt(handle: int): int {
        self.handle = handle;
        if handle < 0 { return -1; }
        return 0;
    }

    # Milliseconds for send and receive; 0 = block forever.
    public timeout(ms: int): int { return nv_net_set_timeout(self.handle, ms); }

    # Raw socket option: "nodelay", "keepalive", "reuseaddr", "broadcast", "linger_ms",
    # "rcvbuf", "sndbuf", "nonblocking". 0 on success.
    public option(name: str, value: int): int {
        return nv_net_set_option(self.handle, name, value);
    }
    public option_of(name: str): int { return nv_net_get_option(self.handle, name); }

    # Non-blocking mode: reads return immediately with what is there (status 1 when empty),
    # so a caller can multiplex with net_poll().
    public nonblocking(): int { return nv_net_set_option(self.handle, "nonblocking", 1); }

    # Sends everything; the number of bytes, or -1. send_line appends "\n".
    public send(text: str): int { return nv_net_send(self.handle, text); }
    public send_line(text: str): int { return nv_net_send(self.handle, text + "\n"); }

    # Up to max bytes (blocks until some data, the peer closes, or the timeout fires).
    # "" is not an error by itself: check status().
    public recv(max_bytes: int): str { return nv_net_recv(self.handle, max_bytes); }

    # One line without the terminator (which is consumed).
    public recv_line(): str { return nv_net_recv_until(self.handle, "\n", 65536); }

    # Until any delimiter; the terminator is not part of the result.
    public recv_until(delim: str, max_bytes: int): str {
        return nv_net_recv_until(self.handle, delim, max_bytes);
    }

    # Exactly n bytes ("" when the peer closes early) — the primitive for a framed protocol.
    public recv_exact(n: int): str { return nv_net_recv_exact(self.handle, n); }

    public peer(): str { return nv_net_peer_addr(self.handle); }
    public local(): str { return nv_net_local_addr(self.handle); }
    public status(): int { return nv_net_status(self.handle); }
    public error(): str { return nv_net_last_error(); }

    # 0 closes the send side (the peer sees end of stream), 1 the receive side, 2 both.
    public shutdown(how: int): int { return nv_net_shutdown(self.handle, how); }
    public close(): int { return nv_net_close(self.handle); }
}

# ── UDP ───────────────────────────────────────────────────────────────────────
# One received datagram: the payload plus who sent it.
class Datagram {
    # Public: a datagram handed to the caller is its payload and its origin.
    public data: str;
    public host: str;
    public port: int;

    public parse(text: str): int {
        bar = index_of(text, "|");
        if bar < 0 { self.data = ""; self.host = ""; self.port = 0; return -1; }
        addr = substr(text, 0, bar);
        self.data = substr(text, bar + 1, len(text) - bar - 1);
        self.host = net_host_of(addr);
        self.port = net_port_of(addr);
        return 0;
    }

    public text(): str {
        return self.host + ":" + str(self.port) + "|" + self.data;
    }
}

class UdpSocket {
    public handle: int;

    # port 0 = any free port (ask for it afterwards with port()).
    public bind(host: str, port: int): int {
        self.handle = nv_net_udp_bind(host, port);
        if self.handle < 0 { return -1; }
        return 0;
    }

    public send_to(host: str, port: int, text: str): int {
        return nv_net_udp_send_to(self.handle, host, port, text);
    }

    # One datagram as "host:port|payload", or "" on timeout/error. A Datagram parses it:
    #     d = new Datagram(); d.parse(u.recv_from(2000));
    public recv_from(timeout_ms: int): str {
        nv_net_set_timeout(self.handle, timeout_ms);
        return nv_net_udp_recv_from(self.handle, 65535);
    }

    # The same, with no timeout change (the socket keeps whatever timeout it had).
    public recv(max_bytes: int): str { return nv_net_udp_recv_from(self.handle, max_bytes); }

    public timeout(ms: int): int { return nv_net_set_timeout(self.handle, ms); }
    public option(name: str, value: int): int {
        return nv_net_set_option(self.handle, name, value);
    }
    public port(): int { return nv_net_local_port(self.handle); }
    public addr(): str { return nv_net_local_addr(self.handle); }
    public status(): int { return nv_net_status(self.handle); }
    public error(): str { return nv_net_last_error(); }
    public close(): int { return nv_net_close(self.handle); }
}


# ── Advanced: bytes, framing and an event loop ───────────────────────────────
#
# For the user writing protocol instead of using a ready-made client: a binary-safe byte
# codec, length-prefixed frames over a stream, and a poll loop (the portable way to watch
# several sockets at once — Narval has no threads on Windows, and a protocol rarely wants
# one thread per connection anyway).
#
# Binary travels as hex text. A Narval string stops at the first NUL byte, so raw bytes
# would truncate: Packet keeps its whole buffer as hex, and the stream helpers
# (send_hex/recv_hex) convert at the socket edge. A user sending lines never sees hex.

def net_platform(): str { return nv_net_platform(); }
def net_caps(): str { return nv_net_caps(); }

# 1 when this build can do `cap` ("tcp", "udp", "dns", "poll", "raw"). Asked at runtime
# instead of presumed: L2 cru needs AF_PACKET on Linux or Npcap on Windows and is not in the
# build yet, so a protocol wanting it has to check first.
def net_has(cap: str): int {
    if index_of(net_caps(), cap) >= 0 { return 1; }
    return 0;
}

# A byte buffer with a read cursor. Covers the fixed-width fields and length-prefixed
# strings a byte-oriented wire format is made of; `le` is 0 for big-endian (the usual wire
# order) and 1 for little-endian. A read past the end returns 0 or "" and sets `err`
# instead of faulting, so a malformed frame becomes a detectable value.
# How many separators a csv has — the ready count of a Poll (kept out of the class so no
# `private` visibility is needed).
def net_count_commas(text: str): int {
    mut i = 0;
    mut n = 0;
    while i < len(text) {
        if index_of(substr(text, i, 1), ",") >= 0 { n = n + 1; }
        i = i + 1;
    }
    return n;
}

class Packet {
    public hex: str;
    public pos: int;
    public detail: str;

    public new() {
        self.hex = "";
        self.pos = 0;
        self.detail = "";
    }

    # Take a buffer in (hex text). Rejects anything that is not an even run of hex digits.
    public load(hex: str): int {
        if nv_net_hex_valid(hex) == 0 {
            self.detail = "not a hex string";
            return -1;
        }
        self.hex = hex;
        self.pos = 0;
        self.detail = "";
        return 0;
    }

    public raw(): str { return self.hex; }
    public size(): int { return nv_net_hex_len(self.hex); }
    public remaining(): int { return nv_net_hex_len(self.hex) - self.pos; }
    public at(): int { return self.pos; }
    public rewind(): int { self.pos = 0; return 0; }
    public ok(): int {
        if len(self.detail) == 0 { return 1; }
        return 0;
    }
    public error(): str { return self.detail; }

    # ── writing (appends at the end; the cursor is for reading) ──
    public put_u8(v: int): int { self.hex = nv_net_pack_int(self.hex, v, 1, 1); return 0; }
    public put_u16(v: int, le: int): int { self.hex = nv_net_pack_int(self.hex, v, 2, le); return 0; }
    public put_u32(v: int, le: int): int { self.hex = nv_net_pack_int(self.hex, v, 4, le); return 0; }
    public put_u64(v: int, le: int): int { self.hex = nv_net_pack_int(self.hex, v, 8, le); return 0; }

    public put_bytes(hex: str): int {
        if nv_net_hex_valid(hex) == 0 {
            self.detail = "not a hex string";
            return -1;
        }
        self.hex = self.hex + hex;
        return 0;
    }

    public put_text(text: str): int {
        self.hex = self.hex + nv_net_str_to_hex(text);
        return 0;
    }

    # u16 length prefix + the bytes: the shape most wire formats use for a string.
    public put_str16(text: str, le: int): int {
        self.put_u16(len(text), le);
        self.put_text(text);
        return 0;
    }

    # ── reading (advances the cursor) ──
    public get_u8(): int {
        if self.remaining() < 1 {
            self.detail = "out of bounds";
            return 0;
        }
        v = nv_net_unpack_int(self.hex, self.pos, 1, 1);
        self.pos = self.pos + 1;
        return v;
    }

    public get_u16(le: int): int {
        if self.remaining() < 2 {
            self.detail = "out of bounds";
            return 0;
        }
        v = nv_net_unpack_int(self.hex, self.pos, 2, le);
        self.pos = self.pos + 2;
        return v;
    }

    public get_u32(le: int): int {
        if self.remaining() < 4 {
            self.detail = "out of bounds";
            return 0;
        }
        v = nv_net_unpack_int(self.hex, self.pos, 4, le);
        self.pos = self.pos + 4;
        return v;
    }

    public get_u64(le: int): int {
        if self.remaining() < 8 {
            self.detail = "out of bounds";
            return 0;
        }
        v = nv_net_unpack_int(self.hex, self.pos, 8, le);
        self.pos = self.pos + 8;
        return v;
    }

    # Binary-safe slice: what comes back is hex, so a payload with NULs survives.
    public get_bytes(n: int): str {
        if n < 0 || self.remaining() < n {
            self.detail = "out of bounds";
            return "";
        }
        out = nv_net_unpack_hex(self.hex, self.pos, n);
        self.pos = self.pos + n;
        return out;
    }

    public get_text(n: int): str {
        chunk = self.get_bytes(n);
        if len(chunk) == 0 { return ""; }
        return nv_net_hex_to_str(chunk);
    }

    public get_str16(le: int): str {
        n = self.get_u16(le);
        if self.ok() == 0 { return ""; }
        return self.get_text(n);
    }
}

# Length-prefixed messages over a stream: a u32 big-endian length, then the payload — the
# order this family of wires uses (the IPv69 header included). `limit` refuses an absurd
# length before anything is read, so a hostile peer cannot ask for a huge allocation.
class Frame {
    public limit: int;
    public detail: str;

    public new() {
        self.limit = 65535;
        self.detail = "";
    }

    public limit_of(n: int): int { self.limit = n; return 0; }
    public ok(): int {
        if len(self.detail) == 0 { return 1; }
        return 0;
    }
    public error(): str { return self.detail; }

    # The frame as hex text: u32be length + payload. Handy to log, queue or compare.
    public wrap(text: str): str {
        return nv_net_pack_int("", len(text), 4, 0) + nv_net_str_to_hex(text);
    }

    public wrap_hex(payload_hex: str): str {
        return nv_net_pack_int("", nv_net_hex_len(payload_hex), 4, 0) + payload_hex;
    }

    # Send/receive on a raw socket handle (any TcpStream's `handle`).
    public send(handle: int, text: str): int {
        return nv_net_send_hex(handle, self.wrap(text));
    }

    public send_hex(handle: int, payload_hex: str): int {
        return nv_net_send_hex(handle, self.wrap_hex(payload_hex));
    }

    # Declarado antes de recv(), que o chama: um metodo de classe so pode chamar um
    # irmao declarado acima (irmao posterior da' "has no body to call").
    public recv_hex(handle: int): str {
        header = nv_net_recv_exact_hex(handle, 4);
        if len(header) < 8 {
            self.detail = "closed or short header";
            return "";
        }
        n = nv_net_unpack_int(header, 0, 4, 0);
        if n < 0 || n > self.limit {
            self.detail = "frame too large";
            return "";
        }
        payload = nv_net_recv_exact_hex(handle, n);
        if len(payload) < n * 2 {
            self.detail = "short payload";
            return "";
        }
        self.detail = "";
        return payload;
    }
    public recv(handle: int): str {
        payload = self.recv_hex(handle);
        if len(payload) == 0 { return ""; }
        return nv_net_hex_to_str(payload);
    }

}

# Poll over handles: `add` the sockets, `wait` with a timeout, then ask which one is ready.
# One handle with the wrong mode is fine (the bridge keeps only valid slots), which is what
# makes this the portable event loop.
class Poll {
    public handles: str;
    public mode: str;
    public ready_csv: str;

    public new() {
        self.handles = "";
        self.mode = "r";
        self.ready_csv = "";
    }

    public add(handle: int): int {
        if len(self.handles) > 0 { self.handles = self.handles + ","; }
        self.handles = self.handles + str(handle);
        return 0;
    }

    public clear(): int {
        self.handles = "";
        self.ready_csv = "";
        return 0;
    }

    public for_read(): int { self.mode = "r"; return 0; }
    public for_write(): int { self.mode = "rw"; return 0; }

    # Number of handles ready within timeout_ms; 0 means "nothing happened".
    public wait(timeout_ms: int): int {
        self.ready_csv = nv_net_poll(self.handles, self.mode, timeout_ms);
        if len(self.ready_csv) == 0 { return 0; }
        return 1 + net_count_commas(self.ready_csv);
    }

    public ready_handles(): str { return self.ready_csv; }
    public timed_out(): int {
        if len(self.ready_csv) == 0 { return 1; }
        return 0;
    }

    # Membership is checked with the delimiters around the number, so handle 4 is not found
    # inside "14".
    public is_ready(handle: int): int {
        needle = "," + str(handle) + ",";
        hay = "," + self.ready_csv + ",";
        if index_of(hay, needle) >= 0 { return 1; }
        return 0;
    }

}

# Raw view over a socket handle: the knobs (options, timeouts, shutdown, poll) without a
# protocol on top. `wrap` adopts a handle you already have (a TcpStream's `handle`, an
# accepted connection), and `close` releases it.
class NetSocket {
    public handle: int;

    public new() { self.handle = -1; }

    public wrap(handle: int): int {
        self.handle = handle;
        return 0;
    }

    public option(name: str, value: int): int { return nv_net_set_option(self.handle, name, value); }
    public get_option(name: str): int { return nv_net_get_option(self.handle, name); }
    public timeout(ms: int): int { return nv_net_set_timeout(self.handle, ms); }
    public shutdown(how: int): int { return nv_net_shutdown(self.handle, how); }
    public close(): int { return nv_net_close(self.handle); }
    public status(): int { return nv_net_status(self.handle); }
    public error(): str { return nv_net_last_error(); }
    public last_len(): int { return nv_net_last_len(); }
    public send_hex(hex: str): int { return nv_net_send_hex(self.handle, hex); }
    public recv_hex(n: int): str { return nv_net_recv_exact_hex(self.handle, n); }

    public ready(mode: str, timeout_ms: int): int {
        csv = nv_net_poll(str(self.handle), mode, timeout_ms);
        if len(csv) > 0 { return 1; }
        return 0;
    }
}
