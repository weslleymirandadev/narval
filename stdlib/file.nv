# Files for Narval: open, read, write, remove.
#
#     from "../stdlib/file.nv" import *;
#     f = new File();
#     f.open("nota.txt", "w");
#     f.write("linha 1\nlinha 2\n");
#     f.close();
#     g = new File();
#     g.open("nota.txt", "r");
#     write(g.read_line());
#     g.close();
#
# The primitives (src/backend/runtime/core/file_bridge.c) keep a small handle
# table; a handle is an int because Narval integers are 32-bit and a FILE* would
# not fit. Modes are the usual C ones: "r", "w", "a", and the binary variants.
from "fileio" import *;

class File {
    handle: int;

    # Opens a file; -1 on failure.
    public open(path: str, mode: str): int {
        self.handle = fileio.open(path, mode);
        return self.handle;
    }

    # Whole remaining content.
    public read(): str {
        return fileio.read(self.handle);
    }

    # One line, without the trailing newline.
    public read_line(): str {
        return fileio.read_line(self.handle);
    }

    # Writes text; the number of characters written, or -1.
    public write(text: str): int {
        return fileio.write(self.handle, text);
    }

    # 0 on success.
    public close(): int {
        return fileio.close(self.handle);
    }
}

# 1 when the path exists.
def file_exists(path: str): int {
    return fileio.exists(path);
}

# Removes a file; 0 on success.
def file_remove(path: str): int {
    return fileio.remove(path);
}
