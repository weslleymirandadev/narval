# Identidade do bait para Narval — endereço derivado e nome `.bait`, a partir do DIGEST da
# chave pública (SHA-512 dela). Endereço e nome saem do mesmo digest:
#
#   addr  = 5 bytes (40 bits): byte 0 com a máscara da classe, bytes 1..4 do digest
#   label = base32 (RFC 4648, minúsculo, sem padding) dos primeiros 160 bits do digest
#   fqdn  = label + ".bait"
#
# Mesma chave = mesmo endereço e mesmo nome em qualquer lugar. A spec é
# `docs/bait-names-spec.md` do repo do IPv69 (`src/BITE/baitname.c`); isto é o porte.
#
#     from "crypto" import * as crypto;
#     from "bait" import * as bait;
#
#     d = crypto.sha512(pub_hex);              # o digest de identidade
#     bait.addr_of_digest(d, "C");             # "8e02a50225"
#     bait.addr_dotted_of_digest(d, "C");      # "8e.02.a5.02.25" (o do `ipv69 addr`)
#     bait.name_of_digest(d);                  # "bybkkarfws5kugfai4hntp6h3qbs6fze.bait"
#
# Este arquivo NÃO importa `crypto`: um arquivo de módulo ainda não consegue importar módulo
# de runtime (módulo `.nv` só enxerga módulos `.nv`), então o digest entra pronto. É também o
# corte que interessa — aqui é aritmética de bits e formatação, lá é primitiva criptográfica.

from "strings" import *;

def bait_hex_digits(): str { return "0123456789abcdef"; }

def bait_b32_alphabet(): str { return "abcdefghijklmnopqrstuvwxyz234567"; }

# Valor de um dígito hex (0-15), ou -1 quando não é hex.
def bait_nib(c: str): int { return index_of(bait_hex_digits(), c); }

# Máscara da classe no byte 0 do digest: A 00|b&3f, B 40|b&3f, C 80|b&3f,
# D c0|b&1f, E e0|b&1f — a classe é o topo do byte e o digest preenche o resto.
def bait_class_byte(hi: int, lo: int, cls: str): int {
    if cls == "A" { return (hi & 3) * 16 + lo; }
    if cls == "B" { return ((hi & 3) | 4) * 16 + lo; }
    if cls == "D" { return ((hi & 1) | 12) * 16 + lo; }
    if cls == "E" { return ((hi & 1) | 14) * 16 + lo; }
    return ((hi & 3) | 8) * 16 + lo;                   # 'C' é o padrão
}

# Endereço de 40 bits em 10 dígitos hex (5 bytes). Classe 'C' quando não se pede outra.
def addr_of_digest(digest_hex: str, cls: str): str {
    d = digest_hex;
    b0 = bait_class_byte(bait_nib(substr(d, 0, 1)), bait_nib(substr(d, 1, 1)), cls);
    return substr(bait_hex_digits(), (b0 >> 4) & 15, 1) + substr(bait_hex_digits(), b0 & 15, 1) + substr(d, 2, 8);
}

# O mesmo endereço pontuado byte a byte, como o `ipv69 addr` imprime.
def addr_dotted_of_digest(digest_hex: str, cls: str): str {
    a = addr_of_digest(digest_hex, cls);
    return substr(a, 0, 2) + "." + substr(a, 2, 2) + "." + substr(a, 4, 2) + "." + substr(a, 6, 2) + "." + substr(a, 8, 2);
}

# Label base32 dos primeiros 160 bits: 40 dígitos hex (4 blocos de 5 bytes) viram 32
# caracteres de 5 bits.
def label_of_digest(digest_hex: str): str {
    d = substr(digest_hex, 0, 40);
    mut out = "";
    mut blk = 0;
    while blk < 4 {
        mut v = 0;
        mut i = 0;
        while i < 10 {
            v = (v << 4) | bait_nib(substr(d, blk * 10 + i, 1));
            i = i + 1;
        }
        mut j = 0;
        while j < 8 {
            out = out + substr(bait_b32_alphabet(), (v >> (35 - 5 * j)) & 31, 1);
            j = j + 1;
        }
        blk = blk + 1;
    }
    return out;
}

# Valor de um caractere base32 (0-31), ou -1 quando não é do alfabeto.
def bait_b32_val(c: str): int { return index_of(bait_b32_alphabet(), c); }

# Caminho reverso: os 8 primeiros caracteres do label são os 5 primeiros bytes do digest
# (40 bits), e a classe volta a ser aplicada — é o que faz o endereço ser derivável só do
# nome. Serve também como validação do label que chega de fora.
def addr_of_label(label: str, cls: str): str {
    mut v = 0;
    mut i = 0;
    while i < 8 {
        v = (v << 5) | bait_b32_val(substr(label, i, 1));
        i = i + 1;
    }
    mut d = "";
    mut j = 0;
    while j < 5 {
        b = (v >> (32 - 8 * j)) & 255;
        d = d + substr(bait_hex_digits(), (b >> 4) & 15, 1) + substr(bait_hex_digits(), b & 15, 1);
        j = j + 1;
    }
    return addr_of_digest(d, cls);      # o endereço só lê os 5 primeiros bytes do digest
}

# Endereço de label em forma pontuada (o que o `ipv69 addr` imprime).
def addr_dotted_of_label(label: str, cls: str): str {
    a = addr_of_label(label, cls);
    return substr(a, 0, 2) + "." + substr(a, 2, 2) + "." + substr(a, 4, 2) + "." + substr(a, 6, 2) + "." + substr(a, 8, 2);
}


def name_of_digest(digest_hex: str): str {
    return label_of_digest(digest_hex) + ".bait";
}

# ── Link: um datagrama IPv69 (header + carga) sobre UDP ─────────────────────────────────
#
# O `net.nv` já fala UDP, mas um `UdpSocket` não atravessa módulo — um `.nv` não enxerga
# classe de outro `.nv` (ver §3.10) — então aqui se usam os MESMOS builtins `nv_net_*` que a
# classe usa, com o header de wire do IPv69 por cima. A carga atravessa como hex, como no
# `net`: string do Narval para no primeiro NUL, e um datagrama é binário.

def link_bind(host: str, port: int): int { return nv_net_udp_bind(host, port); }

def link_close(handle: int): int { return nv_net_close(handle); }

def link_local_port(handle: int): int { return nv_net_local_port(handle); }

# O datagrama inteiro: header de 32 bytes + carga (hex). Montado com as funções livres (e
# não com `WireHdr.pack()`) porque um método de classe do módulo chamado de dentro de uma
# função do módulo ainda não resolve no codegen — ver §3.10. A classe continua sendo a API de
# quem escreve programa (`new WireHdr()` + `wh.pack()` funcionam, coberto em bait_wire.nv).
# `payload_len` é o tamanho em BYTES da carga, por isso o `>> 1` sobre o comprimento do hex.
def link_pack(src_addr: str, dst_addr: str, src_port: int, dst_port: int, seq_hex: str, payload_hex: str): str {
    return "6900" + be16(len(payload_hex) >> 1) + be16(0) + hex_byte(1) + hex_byte(64) + hex_byte(1) + "00" + be16(src_port) + be16(dst_port) + seq_hex + src_addr + "0000" + dst_addr + "0000" + payload_hex;
}

# Envia o datagrama; devolve o que foi escrito, ou -1.
def link_send(handle: int, host: str, port: int, dgram_hex: str): int {
    return nv_net_udp_send_to(handle, host, port, dgram_hex);
}

# Recebe um datagrama como "host:port|dgram_hex", ou "" no timeout.
def link_recv(handle: int, timeout_ms: int): str {
    nv_net_set_timeout(handle, timeout_ms);
    return nv_net_udp_recv_from(handle, 65535);
}

# A carga de um datagrama (o que vem depois do header), em hex.
def link_payload(dgram_hex: str): str { return substr(dgram_hex, 64, len(dgram_hex) - 64); }

# O header de um datagrama, já parseado.
def link_header(dgram_hex: str): WireHdr { return wire_hdr_parse(substr(dgram_hex, 0, 64)); }

# O header normalizado de 32 bytes a partir de qualquer hex de datagrama: parse e pack
# acontecem DENTRO do módulo, onde os métodos da classe resolvem. Chamar `hdr.pack()` num
# objeto que veio de função de módulo ainda não é resolvido pelo codegen (mesma família do
# gap §3.10), então o caminho de fora é este.
def wire_hdr_normalize(hex: str): str {
    wh = wire_hdr_parse(hex);
    return "6900" + be16(wh.payload_len) + be16(wh.flow_id) + hex_byte(wh.next_header) + hex_byte(wh.hop_limit) + hex_byte(wh.flags) + "00" + be16(wh.src_port) + be16(wh.dst_port) + wh.sequence + wh.source + "0000" + wh.dest + "0000";
}

# ── ICSP: o transporte do IPv69 (nh=2) ─────────────────────────────────────────────────
#
# Header de 12 bytes dentro da carga do frame IPv69:
#   src_port(2) dst_port(2) ver(1)=1 flags(1) assoc_id(4) crc16(2)
# e depois um ou mais chunks, cada um [type(1)][flags(1)][len(2, big-endian)] + dados.
# O type 0 é DATA: [tsn(4)][stream_id(2)][stream_seq(2)][carga]. Tipos 1..9 são o handshake
# e o controle (INIT, COOKIE, SACK, HEARTBEAT, SHUTDOWN, RESET) — ver include/ICSP/icsp.h
# do repo do IPv69.
#
# Divergência consciente: o transmissor dele calcula o CRC32c sobre os dois bytes do campo
# de CRC AINDA NÃO ESCRITOS (memória de pilha indefinida) e o receptor NÃO verifica o CRC —
# então o campo sai aleatório por pacote e ninguém olha. Aqui ele é calculado com o campo
# zerado (a convenção sã, a mesma do mac do WireGuard) e `icsp_check` verifica; como o
# receptor dele ignora o campo, a interoperabilidade não depende disso. Vale reportar.

def crc32c(data_hex: str): int {
    mut c = 0xFFFFFFFF;
    mut i = 0;
    while i < len(data_hex) {
        c = (c ^ hex_byte_val(substr(data_hex, i, 2))) & 0xFFFFFFFF;
        mut k = 0;
        while k < 8 {
            if (c & 1) != 0 { c = ((c >> 1) ^ 0x82f63b78) & 0xFFFFFFFF; } else { c = (c >> 1) & 0xFFFFFFFF; }
            k = k + 1;
        }
        i = i + 2;
    }
    return (c ^ 0xFFFFFFFF) & 0xFFFFFFFF;
}

# Um chunk: [type][flags][len BE] + dados (hex).
def icsp_chunk(kind: int, flags: int, data_hex: str): str {
    return hex_byte(kind) + hex_byte(flags) + be16(len(data_hex) >> 1) + data_hex;
}

# O chunk DATA (type 0) de um fluxo.
def icsp_data_chunk(tsn: int, stream_id: int, stream_seq: int, payload_hex: str): str {
    return icsp_chunk(0, 0, be32_hex(tsn) + be16(stream_id) + be16(stream_seq) + payload_hex);
}

# O pacote ICSP inteiro: header + chunks, com o CRC calculado sobre o campo zerado.
def icsp_pack(src_port: int, dst_port: int, assoc_id: int, chunks_hex: str): str {
    head = be16(dst_port) + "01" + "00" + be32_hex(assoc_id);
    crc = crc32c(head + "0000" + chunks_hex);
    return be16(src_port) + head + be16(crc & 65535) + chunks_hex;
}

# 1 quando o CRC do pacote confere.
def icsp_check(pkt_hex: str): int {
    if len(pkt_hex) < 24 { return 0; }
    head = substr(pkt_hex, 4, 16);                     # bytes 2..9: dst_port, ver, flags, assoc_id
    chunks = substr(pkt_hex, 24, len(pkt_hex) - 24);   # tudo depois do campo de CRC
    esperado = substr(pkt_hex, 20, 4);
    if be16(crc32c(head + "0000" + chunks) & 65535) == esperado { return 1; }
    return 0;
}

def icsp_src_port(pkt_hex: str): int { return rd_be16(substr(pkt_hex, 0, 4)); }

def icsp_dst_port(pkt_hex: str): int { return rd_be16(substr(pkt_hex, 4, 4)); }

def icsp_assoc_id(pkt_hex: str): int { return rd_be16(substr(pkt_hex, 12, 4)) * 65536 + rd_be16(substr(pkt_hex, 16, 4)); }

# O primeiro chunk depois do header: [type][flags][len] + dados.
def icsp_first_chunk(pkt_hex: str): str { return substr(pkt_hex, 24, len(pkt_hex) - 24); }

def icsp_chunk_kind(chunk_hex: str): int { return hex_byte_val(substr(chunk_hex, 0, 2)); }

def icsp_chunk_data(chunk_hex: str): str { return substr(chunk_hex, 8, len(chunk_hex) - 8); }

# Endereço de 40 bits (10 dígitos hex) na forma pontuada, como o `ipv69 addr` imprime.
def addr_dotted(addr_hex: str): str {
    return substr(addr_hex, 0, 2) + "." + substr(addr_hex, 2, 2) + "." + substr(addr_hex, 4, 2) + "." + substr(addr_hex, 6, 2) + "." + substr(addr_hex, 8, 2);
}

# ── wire do IPv69: o header de 32 bytes ─────────────────────────────────────────────────
#
# Formato de `include/IPv69/header.h` do repo do IPv69: ver_traffic 0x69 (versão 6,
# traffic class 9), dscp/ecn, payload_len e flow_id big-endian, next_header, hop_limit,
# flags, um reservado, as duas portas big-endian, 4 bytes de sequência, e os dois endereços
# de 40 bits (5 bytes) com 2 bytes reservados cada.
#
# Aritmética de hex em Narval puro, de propósito: é formato, não primitiva — e assim o
# header se lê na linguagem em vez de virar mais um wrapper de C.

def hex_byte(v: int): str { return substr(bait_hex_digits(), (v >> 4) & 15, 1) + substr(bait_hex_digits(), v & 15, 1); }

def be16(v: int): str { return hex_byte((v >> 8) & 255) + hex_byte(v & 255); }

def be32_hex(v: int): str { return be16((v >> 16) & 65535) + be16(v & 65535); }

def hex_byte_val(pair: str): int { return bait_nib(substr(pair, 0, 1)) * 16 + bait_nib(substr(pair, 1, 1)); }

def rd_be16(hex4: str): int { return hex_byte_val(substr(hex4, 0, 2)) * 256 + hex_byte_val(substr(hex4, 2, 2)); }

class WireHdr {
    public mut payload_len: int;
    public mut flow_id: int;
    public mut next_header: int;
    public mut hop_limit: int;
    public mut flags: int;
    public mut src_port: int;
    public mut dst_port: int;
    public mut sequence: str;
    public mut source: str;
    public mut dest: str;

    # Os 32 bytes do header, na ordem do wire. Endereços e sequência entram em hex.
    public pack(): str { return "6900" + be16(self.payload_len) + be16(self.flow_id) + hex_byte(self.next_header) + hex_byte(self.hop_limit) + hex_byte(self.flags) + "00" + be16(self.src_port) + be16(self.dst_port) + self.sequence + self.source + "0000" + self.dest + "0000"; }
}

# O caminho de volta: do hex de 32 bytes para os campos.
def wire_hdr_parse(hex: str): WireHdr {
    h = new WireHdr();
    h.payload_len = rd_be16(substr(hex, 4, 4));
    h.flow_id = rd_be16(substr(hex, 8, 4));
    h.next_header = hex_byte_val(substr(hex, 12, 2));
    h.hop_limit = hex_byte_val(substr(hex, 14, 2));
    h.flags = hex_byte_val(substr(hex, 16, 2));
    h.src_port = rd_be16(substr(hex, 20, 4));
    h.dst_port = rd_be16(substr(hex, 24, 4));
    h.sequence = substr(hex, 28, 8);
    h.source = substr(hex, 36, 10);
    h.dest = substr(hex, 50, 10);
    return h;
}

# 1 quando `text` é hex bem formado (comprimento par, só dígitos hex).
def bait_hex_ok(text: str): int {
    if len(text) % 2 != 0 { return 0; }
    mut i = 0;
    while i < len(text) {
        if bait_nib(substr(text, i, 1)) < 0 { return 0; }
        i = i + 1;
    }
    return 1;
}

# ── keyring (~/.hosts69) — o formato do IPv69 ───────────────────────────────────────────
#
#   key      : a seed em hex, uma linha. Com passphrase o arquivo começa com "H69E1" e traz
#              salt/nonce/seed em caixa; aqui só a forma simples é lida, e a protegida
#              devolve "!" em vez de fingir que entendeu.
#   key.pub  : "<pública hex> <comentário>"
#
# Os caminhos dependem do ambiente, que um arquivo de módulo não lê (ver o gap em
# RUNTIME_MODULES_DESIGN.md §3.10): quem chama passa o HOME e o override IPV69_KEYFILE —
# e o mesmo gap explica os `nv_file_*` crus aqui: um módulo `.nv` importa FUNÇÕES de outro
# módulo `.nv`, mas não enxerga as CLASSES dele (a `File` não existe neste contexto).
# normalmente com `system.env("HOME")` e `system.env("IPV69_KEYFILE")`.

# `override` é palavra reservada na linguagem: o parâmetro chama `keyfile`.
def keyring_key_path(home: str, keyfile: str): str {
    if keyfile != "" { return keyfile; }
    if home == "" { return ""; }
    return home + "/.hosts69/key";
}

def keyring_pub_path(home: str, keyfile: str): str {
    return keyring_key_path(home, keyfile) + ".pub";
}

def keyring_has_key(path: str): int { return nv_file_exists(path); }

# A seed em hex; "" quando não há arquivo, "!" quando o keyring é protegido por passphrase
# (cabeçalho H69E1) ou está fora do formato.
def keyring_read_seed(path: str): str {
    if nv_file_exists(path) == 0 { return ""; }
    h = nv_file_open(path, "r");
    if h < 0 { return ""; }
    line = nv_file_read_line(h);
    nv_file_close(h);
    if len(line) != 64 { return "!"; }
    if bait_hex_ok(line) == 0 { return "!"; }
    return line;
}

# Escreve a seed em hex, uma linha — como o keygen dele escreve. Devolve os caracteres escritos.
def keyring_write_seed(path: str, seed_hex: str): int {
    h = nv_file_open(path, "w");
    if h < 0 { return -1; }
    n = nv_file_write(h, seed_hex + "\n");
    nv_file_close(h);
    return n;
}

# Escreve a pública no formato "<hex> <comentário>".
def keyring_write_pub(path: str, pub_hex: str, comment: str): int {
    h = nv_file_open(path, "w");
    if h < 0 { return -1; }
    n = nv_file_write(h, pub_hex + " " + comment + "\n");
    nv_file_close(h);
    return n;
}

# A pública da primeira coluna do key.pub; "" quando não há arquivo.
def keyring_read_pub(path: str): str {
    if nv_file_exists(path) == 0 { return ""; }
    h = nv_file_open(path, "r");
    if h < 0 { return ""; }
    line = nv_file_read_line(h);
    nv_file_close(h);
    mut i = 0;
    while i < len(line) {
        if substr(line, i, 1) == " " { return substr(line, 0, i); }
        i = i + 1;
    }
    return line;
}
