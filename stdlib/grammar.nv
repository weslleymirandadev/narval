# Narval standard library -- compile-time grammar (BNF) checker (COMPTIME_SPEC 5.11).
#
#     from "stdlib/grammar.nv" import *;
#     write(grammar! {
#         expr   = term (('+' | '-') term)*
#         term   = factor (('*' | '/') factor)*
#         factor = NUMBER | '(' expr ')'
#     });
#
# The body is parsed at compile time. Rules must be named with a lowercase
# letter, nonterminals are checked against the declared rules, direct left
# recursion and two alternatives starting with the same symbol (an LL(1)
# conflict) are rejected with @compileError.
#
# What this emits (COMPTIME_SPEC 5.11, phase 3): for every rule, a recursive-descent
# recognizer `def parse_<rule>(tokens: vector, pos: int): int` that walks a token
# list (a `vector` of `str`) and returns the index after the match, or -1. A caller
# has a full parse when the result equals len(tokens). Alternatives are tried in
# order, which is exact LL(1) dispatch because the validator below already rejects
# two alternatives sharing a first symbol.

comptime def g_is_space(c: str): bool {
    if c == " " {
        return true;
    }
    if c == "\n" {
        return true;
    }
    if c == "\t" {
        return true;
    }
    if c == "\r" {
        return true;
    }
    return false;
}

comptime def g_slice(s: str, start: int, stop: int): str {
    out = "";
    i = start;
    while i < stop {
        out = out + s[i];
        i = i + 1;
    }
    return out;
}

comptime def g_trim(s: str): str {
    start = 0;
    while start < len(s) && g_is_space(s[start]) {
        start = start + 1;
    }
    stop = len(s);
    while stop > start && g_is_space(s[stop - 1]) {
        stop = stop - 1;
    }
    return g_slice(s, start, stop);
}

# Index of the first occurrence of the one-character string `ch`, or -1.
comptime def g_find(s: str, ch: str): int {
    i = 0;
    found = -1;
    while i < len(s) {
        if found < 0 {
            if s[i] == ch {
                found = i;
            }
        }
        i = i + 1;
    }
    return found;
}

# Membership in a list kept as ",a,b,c,".
comptime def g_list_has(list: str, name: str): bool {
    needle = "," + name + ",";
    if len(needle) > len(list) {
        return false;
    }
    i = 0;
    hit = false;
    while i + len(needle) <= len(list) {
        if hit == false {
            j = 0;
            same = true;
            while j < len(needle) {
                if i + j < len(list) {
                    if list[i + j] != needle[j] {
                        same = false;
                        j = len(needle);
                    } else {
                        j = j + 1;
                    }
                } else {
                    same = false;
                    j = len(needle);
                }
            }
            if same {
                hit = true;
            }
        }
        i = i + 1;
    }
    return hit;
}

comptime def g_in(set: str, c: str): bool {
    i = 0;
    found = false;
    while i < len(set) {
        if set[i] == c {
            found = true;
        }
        i = i + 1;
    }
    return found;
}

comptime def g_starts_lower(tok: str): bool {
    if len(tok) == 0 {
        return false;
    }
    return g_in("abcdefghijklmnopqrstuvwxyz_", tok[0]);
}

comptime def g_starts_upper(tok: str): bool {
    if len(tok) == 0 {
        return false;
    }
    return g_in("ABCDEFGHIJKLMNOPQRSTUVWXYZ", tok[0]);
}

# The quoted literal inside a token: `('+'` -> `+`. Empty when there is none.
comptime def g_quoted(tok: str): str {
    open_q = g_find(tok, "'");
    if open_q < 0 {
        return "";
    }
    close_q = -1;
    i = open_q + 1;
    while i < len(tok) {
        if close_q < 0 {
            if tok[i] == "'" {
                close_q = i;
            }
        }
        i = i + 1;
    }
    if close_q < 0 {
        return "";
    }
    return g_slice(tok, open_q + 1, close_q);
}

# ",a,b," -> "a b" (drops the edge commas the lists carry).
comptime def g_list_text(list: str): str {
    out = "";
    i = 0;
    while i < len(list) {
        c = list[i];
        if c == "," {
            if len(out) > 0 {
                out = out + " ";
            }
        } else {
            out = out + c;
        }
        i = i + 1;
    }
    if len(out) > 0 {
        out = g_slice(out, 0, len(out) - 1);
    }
    return out;
}

comptime def g_is_ident_char(c: str): bool {
    return g_in("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c);
}

# The identifier inside a token: `term)*` -> `term`, `('+'` -> `` and `term*` ->
# `term`. Punctuation and EBNF markers are dropped from both ends.
comptime def g_ident_core(tok: str): str {
    start = 0;
    while start < len(tok) && g_is_ident_char(tok[start]) == false {
        start = start + 1;
    }
    stop = len(tok);
    while stop > start && g_is_ident_char(tok[stop - 1]) == false {
        stop = stop - 1;
    }
    return g_slice(tok, start, stop);
}

# ── Parser generation ────────────────────────────────────────────────────────
# Source-text generation fed to @emit; the emitted defs are ordinary Narval and go
# through the normal checker/codegen.

# Index of the ')' matching the '(' at `open`.
comptime def g_group_end(s: str, open: int): int {
    depth = 0;
    i = open;
    while i < len(s) {
        if s[i] == "(" {
            depth = depth + 1;
        }
        if s[i] == ")" {
            depth = depth - 1;
            if depth == 0 {
                return i;
            }
        }
        i = i + 1;
    }
    return len(s) - 1;
}

# Code for one alternative: `p = pos; <steps> return p;`. A group becomes a call to
# its own def; a starred group becomes a `while true` retry loop.
comptime def g_alt_code(path: str, alt: str): str {
    out = "";
    nested = "";
    n = len(alt);
    i = 0;
    while i < n {
        if g_is_space(alt[i]) {
            i = i + 1;
        } else {
            if alt[i] == "(" {
                close = g_group_end(alt, i);
                gname = path + "__g" + str(i);
                nested = nested + g_body_code(gname, g_slice(alt, i + 1, close));
                after = close + 1;
                if after < n && alt[after] == "*" {
                    out = out + "while true {\nq = " + gname + "(tokens, p);\nif q < 0 { break; }\np = q;\n}\n";
                    i = after + 1;
                } else {
                    out = out + "p = " + gname + "(tokens, p);\nif p < 0 { return -1; }\n";
                    i = after;
                }
            } else {
                e = i;
                while e < n && g_is_space(alt[e]) == false {
                    e = e + 1;
                }
                tok = g_slice(alt, i, e);
                lit = g_quoted(tok);
                word = g_ident_core(tok);
                if len(lit) > 0 {
                    out = out + "if p >= len(tokens) { return -1; }\nif tokens[p] != \"" + lit + "\" { return -1; }\np = p + 1;\n";
                } else {
                    if len(word) > 0 {
                        if g_starts_lower(word) {
                            out = out + "p = parse_" + word + "(tokens, p);\nif p < 0 { return -1; }\n";
                        } else {
                            out = out + "if p >= len(tokens) { return -1; }\nif tokens[p] != \"" + word + "\" { return -1; }\np = p + 1;\n";
                        }
                    }
                }
                i = e;
            }
        }
    }
    return "def " + path + "(tokens: vector, pos: int): int {\np = pos;\n" + out + "return p;\n}\n" + nested;
}

# Code for a whole rule body: split at '|' that is not inside parens, one alt def
# each, plus a dispatcher that returns the first alternative that matched.
comptime def g_body_code(name: str, body: str): str {
    alts = "";
    idx = 0;
    start = 0;
    depth = 0;
    i = 0;
    n = len(body);
    while i <= n {
        at_end = i == n;
        is_bar = false;
        if at_end == false {
            c = body[i];
            if c == "(" {
                depth = depth + 1;
            }
            if c == ")" {
                depth = depth - 1;
            }
            if c == "|" && depth == 0 {
                is_bar = true;
            }
        }
        if at_end || is_bar {
            alts = alts + g_alt_code(name + "__a" + str(idx), g_trim(g_slice(body, start, i)));
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }

    disp = "def " + name + "(tokens: vector, pos: int): int {\n";
    j = 0;
    while j < idx {
        if j + 1 < idx {
            disp = disp + "r = " + name + "__a" + str(j) + "(tokens, pos);\nif r >= 0 { return r; }\n";
        } else {
            disp = disp + "return " + name + "__a" + str(j) + "(tokens, pos);\n";
        }
        j = j + 1;
    }
    disp = disp + "}\n";
    return disp + alts;
}

# Validates the BNF and returns a summary of the grammar.
comptime def grammar!(src: str): str {
    # Pass 1: rule names, kept as ",name,name," so membership is a search.
    names = ",";
    rule_count = 0;
    i = 0;
    while i < len(src) {
        e = i;
        while e < len(src) && src[e] != "\n" {
            e = e + 1;
        }
        line = g_trim(g_slice(src, i, e));
        i = e + 1;
        if len(line) > 0 {
            if line[0] != "#" {
                eq = g_find(line, "=");
                if eq < 0 {
                    @compileError("grammar!: rule without '=': " + line)
                }
                name = g_trim(g_slice(line, 0, eq));
                if len(name) == 0 {
                    @compileError("grammar!: rule without a name")
                }
                if g_starts_lower(name) == false {
                    @compileError("grammar!: rule name must start with a lowercase letter: " + name)
                }
                if g_list_has(names, name) {
                    @compileError("grammar!: duplicate rule: " + name)
                }
                names = names + name + ",";
                rule_count = rule_count + 1;
            }
        }
    }
    if rule_count == 0 {
        @compileError("grammar!: no rules")
    }

    # Pass 2: every nonterminal used must be declared, no direct left recursion,
    # no two alternatives starting with the same symbol.
    terminals = ",";
    check = 0;
    rule = "";
    code = "";
    i = 0;
    while i < len(src) {
        e = i;
        while e < len(src) && src[e] != "\n" {
            e = e + 1;
        }
        line = g_trim(g_slice(src, i, e));
        i = e + 1;
        if len(line) > 0 {
            if line[0] != "#" {
                eq = g_find(line, "=");
                rule = g_trim(g_slice(line, 0, eq));
                body = g_trim(g_slice(line, eq + 1, len(line)));
                if len(body) == 0 {
                    @compileError("grammar!: rule '" + rule + "' has no alternatives")
                }

                firsts = ",";
                alt = "";
                j = 0;
                while j <= len(body) {
                    at_end = j == len(body);
                    is_bar = false;
                    if at_end == false {
                        if body[j] == "|" {
                            is_bar = true;
                        }
                    }
                    if at_end || is_bar {
                        a = g_trim(alt);
                        if len(a) == 0 {
                            @compileError("grammar!: empty alternative in rule '" + rule + "'")
                        }
                        # first token of this alternative
                        span = 0;
                        while span < len(a) && g_is_space(a[span]) == false {
                            span = span + 1;
                        }
                        tok = g_ident_core(g_slice(a, 0, span));
                        if len(tok) > 0 {
                            if g_starts_lower(tok) {
                                if g_list_has(names, tok) == false {
                                    @compileError("grammar!: rule '" + rule + "' uses undefined nonterminal '" + tok + "'")
                                }
                            } else {
                                if g_starts_upper(tok) || tok[0] == "'" {
                                    if g_list_has(terminals, tok) == false {
                                        terminals = terminals + tok + ",";
                                    }
                                }
                            }
                            if tok == rule {
                                @compileError("grammar!: rule '" + rule + "' is left recursive")
                            }
                            if g_list_has(firsts, tok) {
                                @compileError("grammar!: rule '" + rule + "' has two alternatives starting with '" + tok + "' (not LL(1))")
                            }
                            firsts = firsts + tok + ",";
                        }

                        # every nonterminal mentioned anywhere in the alternative
                        k = 0;
                        while k < len(a) {
                            tok_start = k;
                            while tok_start < len(a) && g_is_space(a[tok_start]) {
                                tok_start = tok_start + 1;
                            }
                            tok_end = tok_start;
                            while tok_end < len(a) && g_is_space(a[tok_end]) == false {
                                tok_end = tok_end + 1;
                            }
                            raw = g_slice(a, tok_start, tok_end);
                            word = g_ident_core(raw);
                            lit = g_quoted(raw);
                            if len(lit) > 0 {
                                quoted = "'" + lit + "'";
                                if g_list_has(terminals, quoted) == false {
                                    terminals = terminals + quoted + ",";
                                }
                            }
                            if len(word) > 0 {
                                if g_starts_lower(word) {
                                    if g_list_has(names, word) == false {
                                        @compileError("grammar!: rule '" + rule + "' uses undefined nonterminal '" + word + "'")
                                    }
                                }
                                if g_starts_upper(word) {
                                    if g_list_has(terminals, word) == false {
                                        terminals = terminals + word + ",";
                                    }
                                }
                            }
                            k = tok_end + 1;
                            if tok_end >= len(a) {
                                k = len(a);
                            }
                        }
                        alt = "";
                        check = check + 1;
                    } else {
                        alt = alt + body[j];
                    }
                    j = j + 1;
                }

                # The rule validated: generate its recognizer (and any group ones).
                code = code + g_body_code("parse_" + rule, body);
            }
        }
    }

    # Hand the generated defs to the compiler; expand_body splices them in right
    # after the statement that used this macro.
    @emit(code);

    return "grammar: " + str(rule_count) + " rule(s) [" + g_list_text(names) + "], "
           + "terminals [" + g_list_text(terminals) + "]";
}
