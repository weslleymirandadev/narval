# SQLite for Narval.
#
#     from "../stdlib/sqlite.nv" import *;
#     db = new Sqlite();
#     db.open("app.db");
#     db.exec("CREATE TABLE IF NOT EXISTS t (name TEXT)");
#     db.exec("INSERT INTO t VALUES ('bob')");
#     n = db.query("SELECT name FROM t");
#     r = db.row(0);
#     write(r[0]);
#     db.close();
#
# The runtime bridge (src/backend/runtime/core/sqlite_bridge.c) keeps a small
# handle table and loads libsqlite3 on first use, so nothing has to be linked. A
# handle is an int because Narval integers are 32-bit and a pointer would not fit.
# query() runs a statement and stores the result set on the handle; the cells are
# then read back one row at a time, because a vector of vectors cannot be indexed
# twice yet.

class Sqlite {
    handle: int;

    # Opens a database file; -1 on failure.
    public open(path: str): int {
        self.handle = nv_sqlite_open(path);
        return self.handle;
    }

    # Statement that returns no rows: 0 on success, else the SQLite error code.
    public exec(sql: str): int {
        return nv_sqlite_exec(self.handle, sql);
    }

    # Runs a query, stores its result on the handle and returns the number of rows.
    public query(sql: str): int {
        return nv_sqlite_query_run(self.handle, sql);
    }

    # Columns in the stored result of the last query.
    public cols(): int {
        return nv_sqlite_col_count(self.handle);
    }

    # A cell of the stored result, as text ("" when out of range).
    public cell(index: int, col: int): str {
        return nv_sqlite_cell(self.handle, index, col);
    }

    # Rowid of the last insert.
    public last_id(): int {
        return nv_sqlite_last_id(self.handle);
    }

    # Rows changed by the last statement.
    public changes(): int {
        return nv_sqlite_changes(self.handle);
    }

    # Last error message ("" when there is none).
    public error(): str {
        return nv_sqlite_error(self.handle);
    }

    # Closes the database, dropping its stored result: 0 on success.
    public close(): int {
        return nv_sqlite_close(self.handle);
    }

    # Cells of one stored row, as a vector of strings.
    public row(index: int): vector {
        cells = [];
        total = self.cols();
        col = 0;
        while col < total {
            cells.push(self.cell(index, col));
            col = col + 1;
        }
        return cells;
    }
}
