# @derive(clone) / @derive(from_json) — generated instance helpers.
#   ./build/narval tests/derive_clone_json.nv
# from_json is an instance method like the other derived ones (the language has no
# static/class-level calls), so it is called on any instance.
# Expected:
#   bob / 42 / false / false / ana / 7
#   carla / 33 / true
#   true / true
@[derive(debug, clone, from_json)]
class User {
    name: str;
    age: int;
    admin: bool;
}

a = new User();
a.name = "bob";
a.age = 42;
a.admin = true;

# clone: a fresh instance carrying the same values
b = a.clone();
write(b.name);
write(b.age);

# the copy is independent
c = a.clone();
c.name = "ana";
c.age = 7;
write(a.name == c.name);
write(b.name == c.name);

write(c.name);
write(c.age);

# nested object values are skipped while looking for a key
probe = new User();
d = probe.from_json("{\"name\": \"carla\", \"age\": 33, \"admin\": true, \"extra\": {\"nested\": 1}}");
write(d.name);
write(d.age);
write(d.admin);

# a missing key leaves the value empty / false
e = probe.from_json("{\"name\": \"x\"}");
write(e.name == "x");
write(e.admin == false);
