# PoC: um chat em Narval sobre socket TCP, com a conexão mantida aberta. Um lado ouve, o outro
# conecta, e os dois digitam e lêem até alguém encerrar (linha vazia ou Ctrl-D).
#
# Uso (argumentos de linha de comando; o ambiente continua valendo como fallback):
#   ./build-lsp-alltargets/narval tests/poc_chat.nv listen 1919 ana
#   ./build-lsp-alltargets/narval tests/poc_chat.nv connect 127.0.0.1 1919 bob
#
# Limite declarado: a leitura do stdin é bloqueante, então o laço é por turno — o que o outro
# lado mandou aparece assim que você aperta Enter. Intercalar de verdade exige ler o stdin sem
# bloquear (intrínseco que a linguagem ainda não tem) ou uma thread recebendo enquanto a outra
# conversa.
from "net" import *;
from "system" import *;
from "keyboard" import *;

def env_or(nome: str, padrao: str): str {
    mut v = system.env(nome);
    if len(v) == 0 { return padrao; }
    return v;
}

# Argumento i, ou a variável de ambiente do mesmo nome, ou o padrão — nessa ordem.
def arg_or(i: int, nome_env: str, padrao: str): str {
    if i < system.argc(): return system.argv(i);
    return env_or(nome_env, padrao);
}

modo = arg_or(0, "MODE", "listen");
# Os três são VINCULADOS aqui (e não só dentro do if): a linguagem não deixa um valor que
# nasce num bloco aninhado escapar dele — o compilador avisa "no value bound for X here; it is
# only assigned inside a nested block. Using 0" e segue com 0. Vincular antes faz o `if` apenas
# atualizar, que é o que se espera.
mut host = "0.0.0.0";
mut porta = 1919;
mut apelido = "eu";

if modo == "listen" {
    porta = net_digits_to_int(arg_or(1, "PORT", "1919"));
    apelido = arg_or(2, "NICK", "eu");
    host = arg_or(3, "BIND", "0.0.0.0");
} else {
    host = arg_or(1, "HOST", "127.0.0.1");
    porta = net_digits_to_int(arg_or(2, "PORT", "1919"));
    apelido = arg_or(3, "NICK", "eu");
}

t = new TcpStream();

if modo == "listen" {
    ouvinte = new TcpListener();
    
    if ouvinte.bind(host, porta) != 0 {
        write("bind falhou: " + net_last_error());
        exit(1);
    }

    write("esperando alguem na porta " + str(porta) + " ...");
    h = ouvinte.accept(0);
    if h < 0 {
        write("accept falhou: " + net_last_error());
        exit(1);
    }
    t.adopt(h);
} else {
    if t.connect(host, porta, 0) != 0 {
        write("nao conectou em " + host + ":" + str(porta) + ": " + t.error());
        exit(1);
    }
}

write("conectado: " + t.local() + " -> " + t.peer());
write("como \"" + apelido + "\" — escreva e Enter (\"sair\" encerra)");

# Leitura sem travar: o stream em modo nao bloqueante devolve "" quando nao ha nada, entao o
# laco imprime o que chegou na hora e so depois olha o teclado. Como TCP e' fluxo de bytes, as
# linhas sao remontadas aqui: o pedaco que ainda nao tem "\n" fica em `pendente`.
t.nonblocking();
mut pendente = "";
mut vivo = 1;
while vivo == 1 {
    mut tem = 1;
    while tem == 1 {
        dados = t.recv(4096);
        if len(dados) == 0 {
            tem = 0;
        } else {
            pendente = pendente + dados;
            mut fim = index_of(pendente, "\n");
            while fim >= 0 {
                write(substr(pendente, 0, fim));
                pendente = substr(pendente, fim + 1, len(pendente) - fim - 1);
                fim = index_of(pendente, "\n");
            }
        }
    }
    if vivo == 1 {
        if keyboard.ready(50) == 1 {
            linha = keyboard.line();
            if linha == "sair" {
                vivo = 0;
            } else {
                if len(linha) > 0 { t.send_line(apelido + ": " + linha); }
            }
        }
    }
}

# Ultimo dreno: o que chegou enquanto eu decidia sair nao se perde.
mut ultimo = 1;
while ultimo == 1 {
    dados = t.recv(4096);
    if len(dados) == 0 {
        ultimo = 0;
    } else {
        pendente = pendente + dados;
    }
}
mut fim2 = index_of(pendente, "\n");
while fim2 >= 0 {
    write(substr(pendente, 0, fim2));
    pendente = substr(pendente, fim2 + 1, len(pendente) - fim2 - 1);
    fim2 = index_of(pendente, "\n");
}
if len(pendente) > 0 { write(pendente); }

t.send_line(apelido + ": saiu");
t.close();
write("saiu");
