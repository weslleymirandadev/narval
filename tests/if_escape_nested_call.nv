# An assignment inside a branch that cannot be if-converted (one branch contains a
# call, so no select can express it) still has to escape the branch.
#   ./build/narval tests/if_escape_nested_call.nv
# Expected: 2 / a / b
def cells(row: str): vector {
    parts = [];
    cell = "";
    i = 0;
    while i < len(row) {
        c = row[i];
        if c == "\t" {
            parts.push(cell);
            cell = "";
        } else {
            cell = cell + c;
        }
        i = i + 1;
    }
    parts.push(cell);
    return parts;
}

r = cells("a\tb");
write(len(r));
first = r[0];
second = r[1];
write(first);
write(second);
