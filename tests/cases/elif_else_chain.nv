# Cadeia `if / elif / else`: UM ramo executa, e so' um. Corrigido em 2026-09.
# O parser empilhava `elif` e os statements do `else` final num UNICO vetor `alternate`, plano e misto,
# e o codegen emite esse vetor como o corpo do else — entao quando o `if` externo era falso o no' `elif`
# executava e os statements do `else` rodavam em seguida, incondicionalmente: com x=2 saia "dois" E
# "outro". A mesma forma valia para a grafia `else if`. O conserto e' no parser (a origem): a cadeia
# desugara para um if aninhado, `if a {} else { if b {} else { c } }`, e as duas grafias ficam cobertas
# por uma correcao so'. (Duas grafias escritas como um vetor plano e' o mesmo caso de regra duplicada
# que ja produziu o walker dos nomes carregados e o emissor de bloco.)
# Expected:
# um
# dois
# outro
# tres
# 2
# 60
# b
def escolha(x: int): str {
    if x == 1 { return "um"; }
    elif x == 2 { return "dois"; }
    elif x == 3 { return "tres"; }
    else { return "outro"; }
}
write(escolha(1));
write(escolha(2));
write(escolha(9));
write(escolha(3));

mut r = 0;
mut n = 2;
if n == 1 { r = 1; } elif n == 2 { r = 2; } else { r = 3; }
write(str(r));

mut a = 0;
for x2 in [1, 2, 3] {
    if x2 == 1 { a = a + 10; } elif x2 == 2 { a = a + 20; } else { a = a + 30; }
}
write(str(a));

mut y = 2;
if y == 1 { write("a"); } else if y == 2 { write("b"); } else { write("c"); }
