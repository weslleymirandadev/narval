# unroll=N stays refused on purpose: the LLVM backend unrolls by its own cost model and the
# count never reaches it, so accepting it would announce a capacity the compiler does not have.
# Error: CE004

def main(): None {
    a: Tensor<float, [4]> = Tensor.zeros(4);
    b: Tensor<float, [4]> = Tensor.ones(4);
    @[optimize(unroll=4)]
    for i in 0..4 { a[i] = b[i]; }
    write(a.tolist());
}
