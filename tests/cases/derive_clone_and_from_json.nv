# Expected:
# bob
# 42
# false
# false
# zoe
# 7
# true
# false

@[derive(debug, clone, from_json)]
class User {
    name: str;
    age: int;
    admin: bool;
}
a = new User();
a.name = "bob";
a.age = 42;
a.admin = true;
b = a.clone();
write(b.name);
write(b.age);
c = a.clone();
c.name = "ana";
write(a.name == c.name);
write(b.name == c.name);
d = a.from_json("{\"name\": \"zoe\", \"age\": 7, \"extra\": {\"n\": 1}}");
write(d.name);
write(d.age);
write(d.admin == false);
write(d.name == b.name);
