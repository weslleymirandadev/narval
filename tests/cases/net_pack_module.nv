# A superfície do codec de bytes em dois acessos: pelo MÓDULO de runtime (`netio`, o ABI que
# compartilha o net_pack.c) e pela FACE em Narval (`net_pack_int`, do stdlib/net.nv).
# Expected:
# 0000002a
# 42
# 2a000000
# 300
from "netio" import *;
from "net" import *;

write(netio.pack_int("", 42, 4, 0));
write(netio.unpack_int("0000002a", 0, 4, 0));
write(net_pack_int("", 42, 4, 1));
write(net_unpack_int(net_pack_int("aa", 300, 2, 0), 1, 2, 0));
