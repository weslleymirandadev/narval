# @[optimize(parallelize)] on an independent element-wise loop. The checker desugars it into
# a call to the runtime bridge, moving the loop body into a closure the bridge invokes once
# per chunk as (start, end): what ran serially now runs in parallel, and never both. The
# values are the ones the serial loop produces; the parallelism itself is proven at the
# runtime level (PARALLELIZATION_DESIGN F1: distinct thread ids, iterations counted).
# Expected:
# [2.000000, 2.000000, 2.000000, 2.000000]

def main(): None {
    a: Tensor<float, [4]> = Tensor.ones(4);
    b: Tensor<float, [4]> = Tensor.ones(4);
    c: Tensor<float, [4]> = Tensor.zeros(4);
    @[optimize(parallelize)]
    for i in 0..4 { c[i] = a[i] + b[i]; }
    write(c.tolist());
}
