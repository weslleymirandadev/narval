# Expected:
# bob
# 42
# false
# false

@[derive(debug, clone)]
class User {
    public mut name: str;
    public mut age: int;
    public mut admin: bool;
}
a = new User();
a.name = "bob";
a.age = 42;
a.admin = true;
b = a.clone();
write(b.name);
write(b.age);
c = a.clone();
c.name = "ana";
write(a.name == c.name);
write(b.name == c.name);
