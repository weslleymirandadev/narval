# `continue` não tinha cobertura nenhuma: for_range.nv testa `break`, e nada testava o pulo de
# iteração. Aqui valem os dois laços, o range sintático (`0..10`) e o inclusivo (`1..=3`).
# Expected:
# while: n=4 i=6
# for:   m=4
# 1..=3 soma = 6
from "system" import *;

# while: i=1,2 contam; 3 e' pulado; 6 para
mut i = 0;
mut n = 0;
while i < 10 {
    i = i + 1;
    if i == 3 { continue; }
    if i == 6 { break; }
    n = n + 1;
}
write("while: n=" + str(n) + " i=" + str(i));

# for: k=0,1 contam; 2 e' pulado; 3,4 contam; 5 para
mut m = 0;
for k in 0..10 {
    if k == 2 { continue; }
    if k == 5 { break; }
    m = m + 1;
}
write("for:   m=" + str(m));

# range inclusivo
mut s = 0;
for k in 1..=3 {
    s = s + k;
}
write("1..=3 soma = " + str(s));
