def apply(f: (int): int, x: int): int {
    return f(x);
}
def counter(start: int): int {
    n = start;
    f = |x: int|: int { return x + n; };
    return f(100);
}
def main(): int {
    write(apply(|x: int|: int { return x * 3; }, 7));
    write(counter(5));
    g = |a: int, b: int|: int { return a + b; };
    write(g(20, 22));
    return 0;
}
