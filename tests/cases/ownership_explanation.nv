# summary:

class Counter {
    n: int;

    new(n: int) {
        self.n = n;
    }

    public bump(by: int): int {
        self.n = self.n + by;
        return self.n;
    }
}

base = 4;

def add_and_scale(x: int): int {
    total = x + base;
    return total * 3;
}

c = new Counter(10);
write(c.bump(5) + 15);
write(add_and_scale(30));
