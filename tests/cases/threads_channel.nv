# Channels. chan() gives an id, send puts a value in and recv takes the oldest one,
# blocking while the channel is empty. Every message is received exactly once, which is
# what makes this deterministic even though the threads finish in any order: the workers
# all send the same number and the main adds up what it receives.
# The second half goes the other way and shows recv blocking: the worker is already
# waiting when the main sends, and the value crosses threads with its ownership.
# Expected:
# 56
# 99

def run(): int {
    c = chan();
    f = | |: int { send(c, 7); return 0; };

    ids = [];
    for i in 0..8 {
        ids.push(spawn(f));
    }

    total = 0;
    for i in 0..8 {
        total = total + recv(c);
    }
    for i in 0..8 {
        wait(ids[i]);
    }
    write(total);

    d = chan();
    g = | |: int { return recv(d) * 11; };
    h = spawn(g);
    send(d, 9);
    write(wait(h));
    return 0;
}

run();
