# The error path is part of the API: a refused connect, an accept that times out and an
# unknown socket option all have to be visible and harmless (no crash, no silent success).
# Expected:
# refused
# timeout
# unknown option
from "net" import *;

# A port nothing listens on: bind, ask for the number, close it, then connect to it.
t = new TcpListener();
t.bind("127.0.0.1", 0);
free_port = t.port();
t.close();

c = new TcpStream();
if c.connect("127.0.0.1", free_port, 500) != 0 { write("refused"); }

# accept() with a short timeout reports "nothing arrived", it does not hang.
l = new TcpListener();
l.bind("127.0.0.1", 0);
if l.accept(200) == net_no_connection() { write("timeout"); }
l.close();

s = new TcpStream();
if s.option("nosuchoption", 1) != 0 { write("unknown option"); }
