# col_name(i) names a column of the stored result, so a caller finds the column it
# wants by name instead of hard-coding its position; row(i) hands the cells back in
# that order. Out of range gives "" (and no crash).
# Expected:
# 3
# nome
#
# ana
# 7
# Module: sqlite.nv = stdlib/sqlite.nv

from "sqlite" import *;

db = new Sqlite();
db.open(":memory:");
db.exec("CREATE TABLE pessoa (id INTEGER PRIMARY KEY, nome TEXT, altura REAL)");
db.exec("INSERT INTO pessoa VALUES (7, 'ana', 1.62)");
db.query("SELECT id, nome, altura FROM pessoa");
write(db.cols());
write(db.col_name(1));
write(db.col_name(9));

r = db.row(0);
write(r[1]);
write(r[0]);
db.close();
