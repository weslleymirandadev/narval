# Element-wise loops over float tensors do not need @[vectorize]: the shape is what the
# tensor path can lower, and the annotation only asks for the SIMD marker.
# Expected:
# [2.000000, 2.000000, 2.000000, 2.000000]

def main(): None {
    a: Tensor<float, [4]> = Tensor.ones(4);
    b: Tensor<float, [4]> = Tensor.ones(4);
    c: Tensor<float, [4]> = Tensor.zeros(4);
    for i in 0..4 { c[i] = a[i] + b[i]; }
    write(c.tolist());
}
