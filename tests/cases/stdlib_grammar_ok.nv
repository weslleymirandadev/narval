# Expected:
# grammar: 3 rule(s) [expr term factor], terminals ['+' '-' '*' '/' NUMBER '(' ')']
# Module: grammar.nv = stdlib/grammar.nv

from "grammar" import *;

write(grammar! {
    expr   = term (('+' | '-') term)*
    term   = factor (('*' | '/') factor)*
    factor = NUMBER | '(' expr ')'
});
