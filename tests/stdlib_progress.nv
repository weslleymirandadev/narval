# Progress probe for the string helpers: prints a marker before each call, so a
# hang points at the helper that is stuck.
#   ./build/narval tests/stdlib_progress.nv
from "../stdlib/strings.nv" import *;

write("nv_first_nonspace");
write(nv_first_nonspace("  hi  "));

write("nv_last_nonspace");
write(nv_last_nonspace("  hi  "));

write("trim_left");
write(trim_left("  hi  "));

write("trim_right");
write(trim_right("  hi  "));

write("trim");
write(trim("  hi  "));

write("starts_with");
write(starts_with("hello", "he"));

write("ends_with");
write(ends_with("hello", "lo"));

write("starts_at");
write(starts_at("hello", 1, "ell"));

write("index_of");
write(index_of("hello", "ll"));

write("contains");
write(contains("hello", "ell"));

write("substr");
write(substr("hello", 1, 3));

write("count_of");
write(count_of("banana", "an"));

write("split");
parts = split("a,b,c", ",");
write(len(parts));

write("join");
write(join(["x", "y", "z"], "-"));

write("replace");
write(replace("a-b-c", "-", "+"));

write("done");
