# type.ast(f) — AST reflection of a comptime function (COMPTIME_SPEC 5.9).
#   ./build/narval tests/type_ast.nv
# A reflection descriptor is a compile-time struct, so it is consumed inline
# (a `comptime x = <struct>` would have to become a runtime literal, and
# `comptime for` over an array of structs is not supported yet - hence the flat
# param_names/param_types arrays next to the structured `params`).
# Expected (one value per line):
#   poly / false / int / 2
#   x / int
#   assignment / return
#   = / + / *
#   scan2
#   assignment / while / if / assignment / assignment / return
#   add! / true
comptime def poly(x: int): int {
    y = x * x + 3;
    return y;
}

comptime def scan2(s: str): int {
    i = 0;
    while i < len(s) {
        if s[i] == " " {
            i = i + 1;
        }
        i = i + 1;
    }
    return i;
}

comptime def add!(src: str): str {
    return src;
}

write(type.ast(poly).name);
write(type.ast(poly).is_macro);
write(type.ast(poly).return_type);
write(type.ast(poly).statement_count);

comptime for n in type.ast(poly).param_names {
    write(n);
}
comptime for t in type.ast(poly).param_types {
    write(t);
}

comptime for k in type.ast(poly).body_kinds {
    write(k);
}

comptime for op in type.ast(poly).expr_ops {
    write(op);
}

# Nested blocks are walked, so the kinds of the scan loop show up flattened.
write(type.ast(scan2).name);
comptime for k in type.ast(scan2).body_kinds {
    write(k);
}

# Macros are comptime functions too: the trailing ! is visible.
write(type.ast(add).name);
write(type.ast(add).is_macro);
