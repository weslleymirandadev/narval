# Files through the standard library (stdlib/file.nv): open / write / read / remove.
#   ./build/narval tests/file_basic.nv
# Expected: true / 16 / 0 / 1 / true / linha 1 / linha 2 / 0 / 0 / 0
# (file_exists returns 1/0, not a bool)
from "../stdlib/file.nv" import *;

f = new File();
write(f.open("/tmp/narval_file_test.txt", "w") >= 0);
write(f.write("linha 1\nlinha 2\n"));
write(f.close());
write(file_exists("/tmp/narval_file_test.txt"));

g = new File();
write(g.open("/tmp/narval_file_test.txt", "r") >= 0);
write(g.read_line());
write(g.read_line());
write(g.close());

write(file_remove("/tmp/narval_file_test.txt"));
write(file_exists("/tmp/narval_file_test.txt"));
