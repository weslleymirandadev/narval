# @derive(openapi) — OpenAPI 3.0 schema of a class, as JSON text.
#   ./build/narval tests/derive_openapi.nv
# Expected:
#   {"type": "object", "properties": {"name": {"type": "string"}, "age": {"type": "integer"}, "admin": {"type": "boolean"}}, "required": ["name", "age", "admin"]}
@[derive(openapi)]
class User {
    name: str;
    age: int;
    admin: bool;
}

a = new User();
write(a.schema());
