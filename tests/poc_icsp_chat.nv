# PoC: chat estilo netcat sobre ICSP (o transporte de sessao do IPv69), no Ethernet cru, sem
# IPv4 em nenhum ponto do caminho. ICSP vai em next_header=2 (STREAM) e o formato e o do repo
# dele (include/ICSP/icsp.h):
#   header ICSP = 12 bytes [src_port 2][dst_port 2][ver 1][flags 1][assoc_id 4][crc 2]
#   chunk       = [type 1][flags 1][len 2][data]
#   DATA (0)    = [tsn 4][stream_id 2][stream_seq 2][payload]
#   INIT (1), INIT_ACK (2), SACK (5), SHUTDOWN (8) — a mesma numeracao dele.
#
# LIMITE DECLARADO: isto e o FRAMING do ICSP, nao a sessao segura. O INIT daqui leva os campos
# que eu tenho (ver, flags, streams, ephemeral de 32 bytes, ts) e NAO leva a prova de identidade
# (id_pub + assinatura ed25519) nem cookie; os DATA seguem em claro, sem secretbox. Por isso
# este PoC fala Narval<->Narval e NAO com os peers C dele, que exigem handshake autenticado e
# chave derivada. Fechar essa distancia e portar o handshake: as pecas ja estao no modulo
# `crypto` (sha512, sign, keypair, scalarmult, secretbox) e no ed25519 vendorado (hmac_sha512).
#
# Uso (a interface e' resolvida sozinha e o SEU endereco e' derivado da identidade no keyring,
# entao nao se digita o proprio IP — como no ipv69 dele):
#   sudo narval tests/poc_icsp_chat.nv listen                  # exibe o endereco do servidor
#   sudo narval tests/poc_icsp_chat.nv connect <IPv69_do_server>
#   (opcional: `listen <ifname>` / `connect <addr> <ifname>` quando a interface automatica
#    nao for a que voce quer — em laboratorio com veth, por exemplo)
# Em veth, um lado em cada ponta (o TX de uma ponta sai pela outra).
from "bait" import *;
from "net" import *;
from "system" import *;
from "l2" import *;
from "keyboard" import *;

def arg_or(i: int, padrao: str): str {
    if i < system.argc(): return system.argv(i);
    return padrao;
}

# Os campos do INIT dele, sem a identidade: [ver 1][flags 1][streams 2][eph 32][ts 8].
def init_data(): str {
    return "0100000100112233445566778899aabbccddeeff00112233445566778899aabbccddeeff0000000000000000";
}

# O payload de um DATA chunk, nos offsets dele: os 8 primeiros bytes sao tsn+stream+seq.
def data_de_chunk(chunk_hex: str): str {
    d = icsp_chunk_data(chunk_hex);
    if len(d) < 16 { return ""; }
    return substr(d, 16, len(d) - 16);
}

modo = arg_or(0, "listen");

# A interface sai do sistema (a da rota default, como o l2_default_ifname dele) a menos que
# voce diga qual — o mesmo vale para laboratorio, onde nao existe rota default.
mut ifname = "";
mut destino_dotted = "";
if modo == "listen" {
    ifname = arg_or(1, "");
} else {
    destino_dotted = arg_or(1, "");
    ifname = arg_or(2, "");
}
if len(ifname) == 0 { ifname = l2.default_ifname(); }
if len(ifname) == 0 { write("nao achei interface de rede: diga qual, ex. listen wlan0"); exit(1); }

# O endereco NAO se digita: e' derivado da identidade guardada no keyring (na primeira vez ela
# e' criada). Por isso o listen exibe o proprio endereco e o connect so precisa do endereco do
# servidor — como no ipv69 dele.
casa = system.home();
sk = identity_load(keyring_key_path(casa, ""), keyring_pub_path(casa, ""));
meu = identity_addr(sk, "C");
porta = 9696;
assoc = 0x1f904e20;
mut tsn = 1;
mut seq = 0;

def enviar_texto(fd: int, dst_mac: str, dst_addr: str, dst_porta: int, t: int, s: int, texto: str) {
    d = icsp_data_chunk(t, 1, s, net_str_to_hex(texto));
    pkt = icsp_pack(porta, dst_porta, assoc, d);
    f = frame_pack(dst_mac, l2.mac(fd), meu, dst_addr, 2, 64, porta, dst_porta, pkt);
    rc = l2.send(fd, f);
    if system.env("ICSP_DEBUG") == "1" {
        write("[dbg-envio] para mac " + dst_mac + " addr " + addr_dotted(dst_addr) + " bytes=" + str(len(f)) + " rc=" + str(rc));
    }
    if rc != 0 { write("envio falhou"); }
}

fd = l2.open(ifname);
if fd < 0 { write("l2.open(" + ifname + ") falhou: precisa de CAP_NET_RAW e a interface existir"); exit(1); }
write("ICSP em " + ifname + " mac " + l2.mac(fd) + " porta " + str(porta));
if modo == "listen" { write("endereco IPv69 deste servidor: " + addr_dotted(meu) + " — conecte com: connect " + addr_dotted(meu)); }

# --- Handshake: o servidor espera o INIT, o cliente o provoca. Depois os dois percorrem o
# MESMO laco: esvaziar o socket (imprime na hora) e checar o teclado sem travar. O MAC e o
# endereco do peer vem do frame; por isso os dois lados terminam com os mesmos dois valores.
mut peer_mac = "ffffffffffff";
mut peer_addr = "";
mut conectado = 0;

if modo == "listen" {
    while conectado == 0 {
        f = l2.recv(fd, 60000);
        if len(f) > 0 {
            if frame_ethertype_ok(f) == 1 && frame_next_header(f) == 2 && frame_dst_port(f) == porta {
                pkt = frame_payload(f);
                if icsp_check(pkt) == 1 {
                    if icsp_chunk_kind(icsp_first_chunk(pkt)) == 1 {
                        assoc = icsp_assoc_id(pkt);
                        peer_mac = frame_src_mac(f);
                        peer_addr = frame_src_addr(f);
                        ack = icsp_pack(porta, frame_src_port(f), assoc, icsp_chunk(2, 0, init_data()));
                        if l2.send(fd, frame_pack(peer_mac, l2.mac(fd), meu, peer_addr, 2, 64, porta, frame_src_port(f), ack)) != 0 {
                            write("INIT_ACK nao saiu");
                        }
                        write("[icsp] INIT de " + addr_dotted(peer_addr) + ", associacao " + str(assoc) + " — conectado");
                        conectado = 1;
                    }
                }
            }
        }
    }
}
else {
    destino = addr_wire(destino_dotted);
    peer_addr = destino;
    init = icsp_pack(porta, porta, assoc, icsp_chunk(1, 0, init_data()));
    if l2.send(fd, frame_pack("ffffffffffff", l2.mac(fd), meu, destino, 2, 64, porta, porta, init)) != 0 { write("INIT nao saiu"); exit(1); }
    mut tentativas = 0;
    while conectado == 0 && tentativas < 8 {
        f = l2.recv(fd, 1000);
        if len(f) > 0 {
            if frame_next_header(f) == 2 && icsp_check(frame_payload(f)) == 1 {
                if icsp_chunk_kind(icsp_first_chunk(frame_payload(f))) == 2 {
                    peer_mac = frame_src_mac(f);
                    write("[icsp] INIT_ACK de " + addr_dotted(frame_src_addr(f)) + " — conectado (associacao " + str(assoc) + ")");
                    conectado = 1;
                }
            }
        }
        tentativas = tentativas + 1;
    }
    if conectado == 0 { write("sem resposta ao INIT: o outro lado esta ouvindo nessa interface?"); exit(1); }
}

write("conectado com " + addr_dotted(peer_addr) + " — escreva e Enter (\"sair\" encerra)");

# O laco dos dois papeis: primeiro imprime tudo o que chegou (l2.recv com 0 = so o que ja esta
# la, sem esperar), depois olha o teclado sem travar. Fechar so acontece com "sair" ou com um
# SHUTDOWN vindo do outro lado.
mut vivo = 1;
while vivo == 1 {
    mut tem = 1;
    while tem == 1 {
        g = l2.recv(fd, 0);
        if len(g) == 0 {
            tem = 0;
        } else {
            if frame_ethertype_ok(g) == 1 && frame_next_header(g) == 2 && frame_dst_port(g) == porta {
                pkt = frame_payload(g);
                if icsp_check(pkt) == 1 {
                    ch = icsp_first_chunk(pkt);
                    kind = icsp_chunk_kind(ch);
                    if kind == 0 {
                        write(addr_dotted(frame_src_addr(g)) + ": " + net_hex_to_str(data_de_chunk(ch)));
                    }
                    if kind == 8 {
                        write("[icsp] SHUTDOWN do outro lado");
                        vivo = 0;
                        tem = 0;
                    }
                }
            }
        }
    }
    if vivo == 1 {
        if keyboard.ready(50) == 1 {
            linha = keyboard.line();
            if linha == "sair" {
                vivo = 0;
            } else {
                if len(linha) > 0 {
                    enviar_texto(fd, peer_mac, peer_addr, porta, tsn, seq, linha);
                    tsn = tsn + 1;
                    seq = seq + 1;
                }
            }
        }
    }
}

# Ultimo dreno: imprime o que chegou enquanto eu decidia sair.
mut ultimo = 1;
while ultimo == 1 {
    g = l2.recv(fd, 0);
    if len(g) == 0 {
        ultimo = 0;
    } else {
        if frame_ethertype_ok(g) == 1 && frame_next_header(g) == 2 && frame_dst_port(g) == porta {
            pkt = frame_payload(g);
            if icsp_check(pkt) == 1 {
                ch = icsp_first_chunk(pkt);
                if icsp_chunk_kind(ch) == 0 {
                    write(addr_dotted(frame_src_addr(g)) + ": " + net_hex_to_str(data_de_chunk(ch)));
                }
            }
        }
    }
}

# Avisa o outro lado (o par do "sair"): ele encerra o laco pelo SHUTDOWN.
bye = icsp_pack(porta, porta, assoc, icsp_chunk(8, 0, ""));
l2.send(fd, frame_pack(peer_mac, l2.mac(fd), meu, peer_addr, 2, 64, porta, porta, bye));
l2.close(fd);
write("saiu");
