// net.def — o módulo `net`: o codec de bytes do `net_pack.c` (inteiros de largura fixa em
// LE/BE), que é o que o Packet/Frame do `stdlib/net.nv` usa.
//
// Este é o PILOTO da Fase A do RUNTIME_MODULES_DESIGN.md (§8): era ele que devia provar o
// mecanismo antes de qualquer capacidade nova. Os corpos já existem em net_pack.c; aqui só se
// declara a superfície, uma linha por função. `big` é long long (o valor entra como 64 bits).
NV_FN(pack_int,   (bytes, big, num, num), bytes, 4)   // hex + valor + nbytes + le -> hex
NV_FN(unpack_int, (bytes, num, num, num), big,   4)   // hex + pos + nbytes + le -> valor
NV_FN(tcp_listen, (bytes, num), num, 2)
NV_FN(tcp_connect, (bytes, num, num), num, 3)
NV_FN(accept, (num, num), num, 2)
NV_FN(udp_bind, (bytes, num), num, 2)
NV_FN(udp_send_to, (num, bytes, num, bytes), num, 4)
NV_FN(udp_recv_from, (num, num), bytes, 2)
NV_FN(send, (num, bytes), num, 2)
NV_FN(recv, (num, num), bytes, 2)
NV_FN(recv_until, (num, bytes, num), bytes, 3)
NV_FN(recv_exact, (num, num), bytes, 2)
NV_FN(send_hex, (num, bytes), num, 2)
NV_FN(recv_exact_hex, (num, num), bytes, 2)
NV_FN(shutdown, (num, num), num, 2)
NV_FN(close, (num), num, 1)
NV_FN(set_timeout, (num, num), num, 2)
NV_FN(set_option, (num, bytes, num), num, 3)
NV_FN(get_option, (num, bytes), num, 2)
NV_FN(poll, (bytes, bytes, num), bytes, 3)
NV_FN(status, (num), num, 1)
NV_FN(last_error, (), bytes, 0)
NV_FN(last_len, (), num, 0)
NV_FN(resolve, (bytes), bytes, 1)
NV_FN(resolve_all, (bytes), bytes, 1)
NV_FN(hostname, (), bytes, 0)
NV_FN(platform, (), bytes, 0)
NV_FN(local_addr, (num), bytes, 1)
NV_FN(local_port, (num), num, 1)
NV_FN(peer_addr, (num), bytes, 1)
NV_FN(str_to_hex, (bytes), bytes, 1)
NV_FN(hex_to_str, (bytes), bytes, 1)
